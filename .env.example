VT_API_KEY=
VT_API_KEY_BACKUP=       # takes over when the main key hits its quota (comma-separate several)
VT_RPM=4                 # free API = 4 req/min; raise for premium
URLSCAN_API_KEY=
# Passive DNS: Mnemonic works without a key (a free key raises the quota);
# CIRCL pDNS needs an account (https://www.circl.lu/services/passive-dns/)
MNEMONIC_API_KEY=
CIRCL_PDNS_USER=
CIRCL_PDNS_PASS=
# Prior reporting (has this IOC been published / attributed already?)
OTX_API_KEY=             # free: https://otx.alienvault.com (Settings -> API key)
ABUSECH_API_KEY=         # free: https://auth.abuse.ch (ThreatFox + MalwareBazaar + URLhaus)
# Public feeds (Feodo, C2IntelFeeds, OpenPhish, Spamhaus DROP, IPsum, Tor, InternetDB work keyless)
GREYNOISE_API_KEY=       # optional: community API works without; a free key raises the quota
ABUSEIPDB_API_KEY=       # free: https://www.abuseipdb.com/account/api

# Web UI (python infra-mapper.py --web)
INFRAMAPPER_WEB_HOST=127.0.0.1
INFRAMAPPER_WEB_PORT=8770
INFRAMAPPER_WEB_PASSWORD=        # required when INFRAMAPPER_WEB_HOST is not localhost
